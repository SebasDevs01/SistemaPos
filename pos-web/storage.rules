rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permitir lectura de imágenes y facturas generadas
      allow read: if true;
      
      // Permitir subida únicamente de imágenes o facturas PDF (máximo 15 MB)
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
